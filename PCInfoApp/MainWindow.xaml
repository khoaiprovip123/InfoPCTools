<Window x:Class="PCInfoApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PCInfoApp"
        mc:Ignorable="d"
        Title="PCInfoTools"
        Background="{StaticResource BackgroundColor}">
    <Window.Resources>
        <Storyboard x:Key="FadeOut">
            <DoubleAnimation Storyboard.TargetName="MainContentControl"
                             Storyboard.TargetProperty="Opacity"
                             From="1.0" To="0.0" Duration="0:0:0.2"/>
        </Storyboard>
        <Storyboard x:Key="FadeIn">
            <DoubleAnimation Storyboard.TargetName="MainContentControl"
                             Storyboard.TargetProperty="Opacity"
                             From="0.0" To="1.0" Duration="0:0:0.2"/>
        </Storyboard>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/> <!-- Sidebar -->
            <ColumnDefinition Width="*"/> <!-- Main Content -->
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Style="{StaticResource SidebarStyle}">
            <StackPanel Margin="20">
                <TextBlock Text="PCInfoTools" Style="{StaticResource AppTitleStyle}"/>

                <Button Style="{StaticResource MenuButtonStyle}" Click="DashboardButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/assets/icons/dashboard.png" Width="24" Height="24" Margin="0,0,10,0"/>
                        <TextBlock Text="Bảng điều khiển"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource MenuButtonStyle}" Click="SystemInfoButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/assets/icons/system.png" Width="24" Height="24" Margin="0,0,10,0"/>
                        <TextBlock Text="Thông tin hệ thống"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource MenuButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/assets/icons/optimize.png" Width="24" Height="24" Margin="0,0,10,0"/>
                        <TextBlock Text="Tối ưu hóa"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource MenuButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/assets/icons/network.png" Width="24" Height="24" Margin="0,0,10,0"/>
                        <TextBlock Text="Mạng &amp; Bảo mật"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource MenuButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/assets/icons/utilities.png" Width="24" Height="24" Margin="0,0,10,0"/>
                        <TextBlock Text="Bảo trì"/>
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource MenuButtonStyle}" Click="ProcessManagerButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/assets/icons/system_fix.png" Width="24" Height="24" Margin="0,0,10,0"/> <!-- Placeholder icon -->
                        <TextBlock Text="Quản lý tiến trình"/>
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource MenuButtonStyle}" Click="CleanupButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/assets/icons/optimize.png" Width="24" Height="24" Margin="0,0,10,0"/> <!-- Placeholder icon -->
                        <TextBlock Text="Dọn dẹp đĩa"/>
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource MenuButtonStyle}" Click="PerformanceTuningButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/assets/icons/efficiency.png" Width="24" Height="24" Margin="0,0,10,0"/> <!-- Placeholder icon -->
                        <TextBlock Text="Điều chỉnh hiệu suất"/>
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource MenuButtonStyle}" Click="BenchmarkButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/assets/icons/report.png" Width="24" Height="24" Margin="0,0,10,0"/> <!-- Placeholder icon -->
                        <TextBlock Text="Công cụ Benchmark"/>
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource MenuButtonStyle}" Click="RemoteMonitoringButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/assets/icons/network.png" Width="24" Height="24" Margin="0,0,10,0"/> <!-- Placeholder icon -->
                        <TextBlock Text="Giám sát từ xa"/>
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource MenuButtonStyle}" Click="AIIntegrationButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/assets/icons/system.png" Width="24" Height="24" Margin="0,0,10,0"/> <!-- Placeholder icon -->
                        <TextBlock Text="Tích hợp AI"/>
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource MenuButtonStyle}" Click="ReportingButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/assets/icons/report.png" Width="24" Height="24" Margin="0,0,10,0"/> <!-- Placeholder icon -->
                        <TextBlock Text="Báo cáo &amp; Xuất"/>
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource MenuButtonStyle}" Click="DataManagementButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/assets/icons/system.png" Width="24" Height="24" Margin="0,0,10,0"/> <!-- Placeholder icon -->
                        <TextBlock Text="Quản lý dữ liệu"/>
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource MenuButtonStyle}" Click="FinalPolishButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/assets/icons/optimize.png" Width="24" Height="24" Margin="0,0,10,0"/> <!-- Placeholder icon -->
                        <TextBlock Text="Hoàn thiện cuối cùng"/>
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource MenuButtonStyle}" Click="DistributionButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/assets/icons/update.png" Width="24" Height="24" Margin="0,0,10,0"/> <!-- Placeholder icon -->
                        <TextBlock Text="Phân phối"/>
                    </StackPanel>
                </Button>

                <!-- Theme Toggle Button -->
                <Button Style="{StaticResource MenuButtonStyle}" Click="ToggleTheme_Click" Margin="0,20,0,0">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/assets/icons/optimize.png" Width="24" Height="24" Margin="0,0,10,0"/> <!-- Placeholder icon -->
                        <TextBlock Text="Chế độ Sáng/Tối"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <!-- Main Content Area -->
        <ContentControl Grid.Column="1" x:Name="MainContentControl" Margin="20"/>
    </Grid>
</Window>
